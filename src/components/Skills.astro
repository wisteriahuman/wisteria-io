---
const categories: { title: string; skills: string[] }[] = [
  {
    title: 'Languages',
    skills: ['Go', 'TypeScript', 'Python', 'C/C++', 'Java', 'PHP', 'Processing', 'HTML', 'CSS/SCSS'],
  },
  {
    title: 'Backend',
    skills: ['Echo', 'Gin', 'Hono', 'Flask', 'FastAPI', 'Django'],
  },
  {
    title: 'Frontend',
    skills: ['Next.js', 'React', 'WordPress'],
  },
  {
    title: 'CSS / UI',
    skills: ['Tailwind CSS', 'MUI', 'shadcn/ui'],
  },
  {
    title: 'Database',
    skills: ['PostgreSQL', 'MySQL', 'Redis', 'Supabase', 'Drizzle ORM', 'SQLAlchemy'],
  },
  {
    title: 'Infrastructure',
    skills: ['Docker', 'Cloudflare'],
  },
  {
    title: 'AI / ML',
    skills: ['PyTorch', 'scikit-learn', 'NumPy', 'Matplotlib'],
  },
  {
    title: 'Linux',
    skills: ['Ubuntu', 'Pop!_OS', 'CachyOS', 'Garuda'],
  },
  {
    title: 'Tools',
    skills: ['Neovim', 'tmux', 'Git', 'Sway'],
  },
];
---

<section id="skills" class="pt-14">
  <h2 class="text-[1.375rem] font-bold text-ink"><span class="marker">Skills</span></h2>
  <dl class="mt-7 space-y-7 md:space-y-0">
    {categories.map(cat => (
      <div class="relative">
        <dt class="margin-note font-bold text-ink">{cat.title}</dt>
        <dd class="text-ink">{cat.skills.join('・')}</dd>
      </div>
    ))}
  </dl>
</section>
