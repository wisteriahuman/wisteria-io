---
import { career } from '../data/career';
---

<section id="experience" class="py-24 px-6 bg-bg-card/30">
  <div class="max-w-3xl mx-auto space-y-8">
    <h2 class="text-3xl font-bold text-white">Experience</h2>
    <div class="space-y-0">
      {career.map((item, i) => (
        <div id={`career-${item.id}`} class="relative pl-8 pb-10 last:pb-0 scroll-mt-24">
          <div class="absolute left-0 top-1.5 w-3 h-3 bg-primary rounded-full ring-4 ring-bg-dark"></div>
          {i < career.length - 1 && (
            <div class="absolute left-[5px] top-4 w-0.5 h-full bg-border"></div>
          )}
          <p class="text-accent text-sm font-[JetBrains_Mono]">{item.period}</p>
          <h3 class="text-white font-semibold text-lg mt-1">{item.title}</h3>
          <p class="text-primary-light text-sm">{item.subtitle}</p>
          {item.desc && <p class="text-text-muted text-sm mt-2">{item.desc}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
