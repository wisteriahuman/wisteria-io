---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/avatar.jpg';
import { profile, ratings } from '../data/profile';
import { highlights } from '../data/career';

const links = [
  { label: 'GitHub', href: 'https://github.com/wisteriahuman', icon: 'github' as const },
  { label: 'X', href: 'https://x.com/wisteria_man', icon: 'x' as const },
  { label: 'AtCoder', href: 'https://atcoder.jp/users/wisteriahuman', icon: null },
];
---

<section id="top" class="px-6 pt-24 pb-12 md:pt-36 md:pb-24">
  <div class="max-w-3xl mx-auto text-center">
    <Image src={avatar} alt="" width={64} height={64} loading="eager" class="w-16 h-16 rounded-full mx-auto object-cover ring-2 ring-accent/30" />
    <h1 class="mt-4 text-4xl md:text-6xl font-bold text-white">{profile.name}</h1>
    <p class="mt-3 text-base md:text-lg text-text-main">{profile.affiliation}</p>

    <ul class="mt-6 flex flex-wrap justify-center gap-2">
      {highlights.map((h) => (
        <li>
          <a href={`#career-${h.id}`}
            class="inline-flex items-center gap-1.5 min-h-9 px-3 rounded-full bg-primary/25 hover:bg-primary/40 border border-primary/40 text-white text-sm transition-colors">
            <Icon name="trophy" class="w-4 h-4 text-primary-light shrink-0" />
            <span>{h.label.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="inline-block">{word}</span></>)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm text-text-muted">{ratings.join('・')}</p>

    <div class="mt-6 flex justify-center gap-3">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 min-h-11 px-4 bg-white/10 hover:bg-white/20 rounded-lg text-white transition-colors text-sm">
          {l.icon && <Icon name={l.icon} class="w-5 h-5" />}
          {l.label}
        </a>
      ))}
    </div>
  </div>
</section>
