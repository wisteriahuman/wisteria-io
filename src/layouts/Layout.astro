---
import '../styles/global.css'
import { profile, summary } from '../data/profile';
import { buildVersion } from '../lib/last-updated';
import { person } from '../lib/person';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = `${profile.name} (${profile.handle}) | ポートフォリオ`,
  description = summary,
  image = '/og.png',
  url,
  type = 'website',
  structuredData,
} = Astro.props;

const siteUrl = profile.url.replace(/\/$/, '');
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=optional';
// 手書きの書体は、届いたら差し替える。行の高さが決まっているので、差し替えてもレイアウトは上下に動かない（ADR-016）
const handUrl = 'https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap';
const ogImage = `${siteUrl}${image}?v=${buildVersion}`;
// クエリや末尾スラッシュの違いを、サイトマップと同じ URL にまとめる。
const pathname = url ?? Astro.url.pathname;
const canonical = new URL(`${pathname.replace(/\/$/, '')}/`, profile.url).href;
const data = structuredData ?? (pathname === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': profile.url,
  url: profile.url,
  mainEntity: person,
} : undefined);
const jsonLd = data ? JSON.stringify(data).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<!--
          _     _            _
 __      (_)___| |_ ___ _ __ (_) __ _
 \ \ /\ / / / __| __/ _ \ '__| |/ _` |
  \ V  V /| \__ \ ||  __/ |  | | (_| |
   \_/\_/ |_|___/\__\___|_|  |_|\__,_|

作りは GitHub と docs/ にあります
https://github.com/wisteriahuman/wisteria-io
https://github.com/wisteriahuman/wisteria-io/tree/main/docs
-->
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="alternate" type="application/rss+xml" title="wisteria のブログ" href={`${siteUrl}/rss.xml`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="wisteria" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 日本語は端末のフォントで描き、英字のフォントは描画を止めずに読み込む（ADR-009） -->
    <link rel="preload" as="style" href={fontsUrl} onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" as="style" href={handUrl} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={fontsUrl} /><link rel="stylesheet" href={handUrl} /></noscript>
    <title>{title}</title>
  </head>
  <body class="antialiased text-ink">
    <slot />
  </body>
</html>
