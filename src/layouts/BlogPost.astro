---
import AskAI from '../components/AskAI.astro';
import BuildNote from '../components/BuildNote.astro';
import PageHead from '../components/PageHead.astro';
import { profile } from '../data/profile';
import { noteDate } from '../lib/last-updated';
import { person } from '../lib/person';
import { tornEdge } from '../lib/torn-edge';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  no: number;
  file: string;
}

const { title, description, pubDate, tags, slug, no, file } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${title} | wisteria`}
  description={description}
  image={`/og/${slug}.png`}
  url={`/blog/${slug}/`}
  type="article"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    mainEntityOfPage: new URL(`/blog/${slug}/`, profile.url).href,
    image: new URL(`/og/${slug}.png`, profile.url).href,
    author: person,
  }}
>
  <main class="pad">
    <article class="page page-plain" style={`--torn: ${tornEdge(200 + no)}`}>
      <PageHead no={no} date={noteDate(pubDate)} />
      <p class="mt-7"><a href="/blog/" class="text-pen underline underline-offset-4">記事一覧に戻る</a></p>
      <header class="mt-7 mb-14">
        <h1 class="text-[1.75rem] md:text-[2rem] leading-14 font-bold text-ink">{title}</h1>
        <p class="text-sm text-ink-muted">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>{tags.length > 0 && <>・{tags.join('・')}</>}
        </p>
      </header>
      <div class="blog-content">
        <slot />
      </div>
      <p class="mt-7">書いた人：<a href="/" rel="author" class="text-pen underline underline-offset-4">{profile.name}（{profile.handle}）</a></p>
      <AskAI articleUrl={new URL(`/blog/${slug}/`, profile.url).href} />
      <BuildNote files={[file]} label="この記事の履歴" />
    </article>
  </main>
</Layout>

<style is:global>
  @reference "../styles/global.css";

  /* 記事の本文も罫線に乗せる。縦の寸法はすべて行の高さ（28px）の倍数にする */
  .blog-content {
    container-type: inline-size;
    /* 長いパスやコマンドを、狭い画面で折り返す */
    overflow-wrap: break-word;
  }

  .blog-content > :first-child {
    @apply mt-0;
  }

  .blog-content h2 {
    @apply text-[1.375rem] font-bold text-ink mt-14;
  }

  .blog-content h3 {
    @apply text-lg font-bold text-ink mt-7;
  }

  .blog-content :is(p, ul, ol, table, pre, blockquote, figure) {
    @apply mb-7;
  }

  .blog-content :is(ul, ol) {
    @apply pl-6;
  }

  .blog-content ul {
    @apply list-disc;
  }

  .blog-content ol {
    @apply list-decimal;
  }

  .blog-content a {
    @apply text-pen underline underline-offset-4;
  }

  /* 行内のコード。行の箱を高くしないよう line-height を 1 にする */
  .blog-content code {
    @apply font-mono text-[0.875rem] text-ink;
    line-height: 1;
    padding: 0 0.3em;
    background-color: color-mix(in srgb, var(--color-rule) 35%, transparent);
  }

  /* コードはノートに貼った印刷物。横スクロールのバーで高さが変わらないよう折り返す */
  .blog-content pre {
    @apply rounded-md text-[0.875rem];
    padding: 0.875rem 1rem;
    line-height: var(--line);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .blog-content pre code {
    padding: 0;
    background-color: transparent;
    color: inherit;
    line-height: inherit;
  }

  .blog-content blockquote {
    @apply pl-4 text-ink-muted;
    box-shadow: inset 2px 0 0 var(--color-margin);
  }

  .blog-content hr {
    @apply mb-7;
    height: var(--line);
    border: 0;
  }

  /* 表は罫線を区切りにして、セルを折り返す */
  .blog-content table {
    @apply w-full;
    border-collapse: collapse;
  }

  .blog-content :is(th, td) {
    @apply pr-3 align-top text-left;
    overflow-wrap: anywhere;
  }

  .blog-content th {
    @apply font-bold;
  }

  /* 図は紙の上に描く。枠の高さを罫線の倍数に切り上げ、後ろの文字がずれないようにする */
  .blog-content .mermaid {
    @apply flex justify-center;
    height: round(up, calc(min(100cqw, var(--fw)) * var(--ratio)), var(--line));
  }

  .blog-content .mermaid svg {
    @apply h-auto;
  }
</style>
