---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
}

const { title, description, pubDate, tags, slug } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${title} | wisteria`}
  description={description}
  image={`/og/${slug}.png`}
  url={`/blog/${slug}`}
  type="article"
>
  <main class="min-h-screen pt-20 pb-24 px-6">
    <article class="max-w-3xl mx-auto">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-ink-muted hover:text-wisteria transition-colors text-sm mb-8"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        記事一覧に戻る
      </a>

      <header class="mb-10">
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-ink mb-4">{title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-ink-muted mb-4">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <span class="px-3 py-1 bg-surface text-ink-muted text-sm rounded-md">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="blog-content">
        <slot />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  @reference "../styles/global.css";

  /* 記事の本文も罫線に乗せる。縦の寸法はすべて行の高さ（28px）の倍数にする */
  .blog-content {
    container-type: inline-size;
  }

  .blog-content h2 {
    @apply text-[22px] font-bold text-ink mt-14;
  }

  .blog-content h3 {
    @apply text-lg font-bold text-ink mt-7;
  }

  .blog-content :is(p, ul, ol, table, pre, blockquote, figure) {
    @apply mb-7;
  }

  .blog-content :is(ul, ol) {
    @apply pl-6;
  }

  .blog-content ul {
    @apply list-disc;
  }

  .blog-content ol {
    @apply list-decimal;
  }

  .blog-content a {
    @apply text-pen underline underline-offset-4;
  }

  /* 行内のコード。行の箱を高くしないよう line-height を 1 にする */
  .blog-content code {
    @apply font-mono text-[14px] text-ink;
    line-height: 1;
    padding: 0 0.3em;
    background-color: color-mix(in srgb, var(--color-rule) 35%, transparent);
  }

  /* コードはノートに貼った印刷物。横スクロールのバーで高さが変わらないよう折り返す */
  .blog-content pre {
    @apply rounded-md text-[14px];
    padding: 14px 16px;
    line-height: 28px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .blog-content pre code {
    padding: 0;
    background-color: transparent;
    color: inherit;
    line-height: inherit;
  }

  .blog-content blockquote {
    @apply pl-4 text-ink-muted;
    box-shadow: inset 2px 0 0 var(--color-margin);
  }

  .blog-content hr {
    @apply mb-7;
    height: 28px;
    border: 0;
  }

  /* 表は罫線を区切りにして、セルを折り返す */
  .blog-content table {
    @apply w-full;
    border-collapse: collapse;
  }

  .blog-content :is(th, td) {
    @apply pr-3 align-top text-left;
    overflow-wrap: anywhere;
  }

  .blog-content th {
    @apply font-bold;
  }

  /* 図は紙の上に描く。枠の高さを罫線の倍数に切り上げ、後ろの文字がずれないようにする */
  .blog-content .mermaid {
    @apply flex justify-center;
    height: round(up, calc(min(100cqw, var(--fw)) * var(--ratio)), 28px);
  }

  .blog-content .mermaid svg {
    @apply h-auto;
  }
</style>
