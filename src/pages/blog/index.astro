---
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import PageHead from '../../components/PageHead.astro';
import Layout from '../../layouts/Layout.astro';
import { lastUpdated } from '../../lib/last-updated';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | wisteria">
  <div class="spread">
    <aside class="page page-left" aria-label="ブログ">
      <PageHead date={lastUpdated} />
      <p class="mt-7"><a href="/" class="text-pen underline underline-offset-4">ポートフォリオに戻る</a></p>
      <h1 class="mt-7 text-[2rem] leading-14 font-bold text-ink"><span class="marker">Blog</span></h1>
      <p class="text-ink-muted">技術的なメモや振り返りを書いています</p>
    </aside>
    <main class="page page-right pb-14">
      {posts.length === 0 ? (
        <p class="text-ink-muted">まだ記事がありません</p>
      ) : (
        <ul class="space-y-7">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.slug}
            />
          ))}
        </ul>
      )}
    </main>
  </div>
</Layout>
