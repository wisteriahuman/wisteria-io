      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@types/hast": "^3.0.5",
